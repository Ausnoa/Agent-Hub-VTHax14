ANS_BASE_URL=https://api.godaddy.com
ANS_AUTHORIZATION=
ANS_AUTHENTICATED_DISCOVERY=false
OPENAI_API_KEY=
OPENAI_MODEL=
# Reasoning models (gpt-5*, o*) spend max_output_tokens on reasoning before answering,
# which shows up as "Model generation unavailable (output-limit)" or a step timeout.
# Set low (or minimal) for those models; leave empty for non-reasoning models.
OPENAI_REASONING_EFFORT=
# Optional: model used only for composing a workflow, where reasoning pays off.
# Agent tasks (summarize/extract/answer) stay on OPENAI_MODEL, which should be a fast
# non-reasoning model. Unset means the planner also uses OPENAI_MODEL.
OPENAI_PLANNER_MODEL=
COMPATIBLE_AGENTS_JSON={}
COMPOSER_DB=.data/composer.sqlite
PILOT_CATALOG_DB=.data/pilot-catalog.sqlite
# Minutes between worker registry syncs; 0 disables syncing (see docs/DEVELOPMENT.md)
ANS_SYNC_INTERVAL_MINUTES=30
# Owned stateless summary agent (public inference is opt-in)
AGENT_PUBLIC_ORIGIN=https://www.gloryforglorria.us
AGENT_ENABLED=false
# Separate ANS identities on the same deployment. Add each hostname in Vercel.
EXTRACT_AGENT_PUBLIC_ORIGIN=https://extract.gloryforglorria.us
QA_AGENT_PUBLIC_ORIGIN=https://ask.gloryforglorria.us
# Hosted builder: Supabase public project configuration (never use a secret key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only after applying the hosted migration and configuring model credentials
HOSTED_AGENT_TESTS_ENABLED=false
# Prisma (server-only; never NEXT_PUBLIC_; loaded via prisma.config.ts, not this
# file directly -- put real values in a root .env). From Supabase: Project
# Settings -> Database -> Connection string. DATABASE_URL = Transaction pooler
# (port 6543), used by Prisma Client at runtime via @prisma/adapter-pg.
# DIRECT_URL = Session pooler (same pooler host, port 5432; NOT the dashboard's
# "Direct connection" string, which is IPv6-only), used only by `prisma db pull`
# and any future migrate/db push. See docs/DECISION-006-PRISMA-INTEGRATION.md.
DATABASE_URL=
DIRECT_URL=
